# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Cloudflare email worker (email-worker/) — deployed URL, e.g.
# https://lc-psi-email-worker.<account>.workers.dev
# Server-only: called from a server action, never shipped to the browser.
CONTACT_WORKER_URL=
# Shared secret the worker checks via the X-Contact-Secret header.
# Must match the value set with `npx wrangler secret put CONTACT_WORKER_SECRET`
# in email-worker/. Generate with: openssl rand -hex 32
CONTACT_WORKER_SECRET=
